{
    "project_name": "sql-ecommerce-data-engineering",
    "pipeline_name": "hybrid_ecommerce_data_pipeline",
    "database": {
        "type": "sqlite",
        "file_name": "ecommerce_data_engineering.db",
        "foreign_keys_enabled": true
    },
    "directories": {
        "synthetic_raw_data": "data/raw/synthetic",
        "pawchoice_raw_data": "data/raw/pawchoice",
        "staging_data": "data/staging",
        "processed_data": "data/processed",
        "database": "database",
        "logs": "logs"
    },
    "synthetic_files": {
        "customers": "customers.csv",
        "products": "products.csv",
        "orders": "orders.csv",
        "order_items": "order_items.csv",
        "payments": "payments.csv"
    },
    "pawchoice_files": {
        "influencer_payments": "pawchoice_payments.xlsx",
        "payment_sheet": "สรุปรอบจ่าย"
    },
    "pipeline": {
        "mode": "demo",
        "load_type": "incremental",
        "watermark_column": "loaded_at",
        "default_watermark": "1900-01-01 00:00:00",
        "stop_on_quality_failure": true,
        "timezone": "UTC",
        "incremental_lookback_minutes": 10,
        "watermark_future_tolerance_minutes": 5
    },
    "monitoring": {
        "sla_enabled": true,
        "step_sla_seconds": {
            "SETUP_DATABASE": 10.0,
            "LOAD_RAW_DATA": 30.0,
            "RUN_TRANSFORMATIONS": 15.0,
            "RUN_QUALITY_CHECKS": 10.0
        }
    },
    "privacy": {
        "hash_bank_accounts": true,
        "hash_phone_numbers": true,
        "mask_account_names": true,
        "sanitize_notes": true,
        "store_raw_pii": false
    },
    "quality": {
        "freshness_threshold_hours": 24,
        "amount_tolerance": 0.01,
        "allowed_order_statuses": [
            "PENDING",
            "PROCESSING",
            "COMPLETED",
            "CANCELLED",
            "REFUNDED"
        ],
        "allowed_payment_methods": [
            "CREDIT_CARD",
            "DEBIT_CARD",
            "BANK_TRANSFER",
            "E_WALLET",
            "CASH"
        ],
        "allowed_payment_statuses": [
            "PENDING",
            "PAID",
            "FAILED",
            "REFUNDED",
            "CANCELLED"
        ],
        "allowed_influencer_payment_statuses": [
            "PAID",
            "UNPAID",
            "CANCELLED"
        ],
        "thresholds": {
            "error_max_issue_count": 5,
            "error_max_issue_rate_percent": 1.0
        },
        "severity_policy": {
            "critical_any_issue_fails": true,
            "warning_stops_pipeline": false
        }
    },
    "logging": {
        "enabled": true,
        "level": "INFO",
        "file_name": "pipeline.log"
    }
}
